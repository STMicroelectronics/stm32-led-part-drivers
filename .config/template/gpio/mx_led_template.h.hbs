{{assign 'led_instances' (@root.SWConfigurationAPI.getInstances  "STMicroelectronics::Board Part:STM32CubeMX2 Config:LED")~}}

/* Define to prevent recursive inclusion ----------------------------------- */
#ifndef MX_LED_H
#define MX_LED_H

#ifdef __cplusplus
extern "C" {
#endif

/* Includes ---------------------------------------------------------------- */
#include "led.h"
#include "mx_hal_def.h"

/* Exported macros --------------------------------------------------------- */
{{#each @root.led_instances}}
{{assign 'ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{#with @root.ctx}}
{{#if (eq info.interface 'GPIO')~}}
/* LED names - GPIO flavor */
/* These names are just identifiers without a value.
 * The LED part driver uses those names to construct pin property macros.
 * e.g. `led_on(LED_{{@index}})` translates to
 * `HAL_GPIO_WritePin(LED_{{@index}}_GPIO_PORT, LED_{{@index}}_PIN, LED_{{@index}}_ACTIVE_STATE)`.
 */

#define LED_{{@index}}                    {{@index}} /* Main label */

{{#if (length info.labels)}}
/* User-defined aliases */
{{else}}
/* No label has been defined for this part driver instance,
 * so no alias is generated for LED_{{@index}}. */
{{/if}}
{{#each info.labels}}
#define {{this}}                          LED_{{@../index}}
{{/each}}

/* Resource bindings */
{{assign 'gpioSWInstanceId' (@root.SWConfigurationAPI.getBoundSwInstanceId resourcesAllocation.gpioCfg.pinCfg)~}}
{{assign 'gpioPinCfg' (@root.SWConfigurationAPI.getPinConfiguration @root.gpioSWInstanceId resourcesAllocation.gpioCfg.pinCfg.selection)~}}
{{assign 'gpioPinData' (@root.pinoutAPI.getPinData resourcesAllocation.gpioCfg.pinCfg.selection)~}}

#define LED_{{@index}}_GPIO_PORT          HAL_GPIO{{@root.gpioPinData.port}}
#define LED_{{@index}}_PIN                HAL_GPIO_PIN_{{@root.gpioPinData.index}}
#define LED_{{@index}}_ACTIVE_STATE       {{#if (eq @root.gpioPinCfg.basic.output_active_state 'SET')}}HAL_GPIO_PIN_SET{{else}}HAL_GPIO_PIN_RESET{{/if}}
#define LED_{{@index}}_INACTIVE_STATE     {{#if (eq @root.gpioPinCfg.basic.output_active_state 'SET')}}HAL_GPIO_PIN_RESET{{else}}HAL_GPIO_PIN_SET{{/if}}

{{#each info.labels}}
#define {{this}}_GPIO_PORT          LED_{{@../index}}_GPIO_PORT
#define {{this}}_PIN                LED_{{@../index}}_PIN
#define {{this}}_ACTIVE_STATE       LED_{{@../index}}_ACTIVE_STATE
#define {{this}}_INACTIVE_STATE     LED_{{@../index}}_INACTIVE_STATE
{{/each~}}

{{/if~}}  {{!-- eq info.interface 'GPIO' --}}
{{/with~}} {{!-- @root.ctx --}}
{{/each~}} {{!-- @root.led_instances --}}

#ifdef __cplusplus
}
#endif

#endif /* MX_LED_H */
