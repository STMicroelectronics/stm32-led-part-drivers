{{assign 'led_instances' (@root.SWConfigurationAPI.getInstances  "STMicroelectronics::Board Part:STM32CubeMX2 Config:LED")~}}

/* Define to prevent recursive inclusion ----------------------------------- */
#ifndef MX_LED_PWM_H
#define MX_LED_PWM_H

#ifdef __cplusplus
extern "C" {
#endif

/* Includes ---------------------------------------------------------------- */
#include "led_pwm.h"
#include "mx_hal_def.h"

/* Exported macros --------------------------------------------------------- */
{{#each @root.led_instances}}
{{assign 'ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{#with @root.ctx}}
{{#if (eq info.interface 'PWM')~}}
/* Part Config ID */
#define LED_PWM_{{@index}}                              {{@index}} /* Main label */

{{#if (length info.labels)}}
/* User-defined aliases for the part drivers instances IDs and getter functions */
{{else}}
/* No label has been defined for this part driver instance,
 * so no alias is generated for LED_PWM_{{@index}} or mx_led_pwm_{{@index}}_getobject(). */
{{/if}}
{{#each info.labels}}
#define {{this}}                          LED_PWM_{{@../index}}
{{/each}}
{{#each info.labels}}
#define {{lowercase this}}_getobject()    mx_led_pwm_{{@../index}}_getobject()
{{/each}}

/* Resource bindings */
{{#with resourcesAllocation.pwmCfg}}
#define LED_PWM_{{@index}}_TIM_GETHANDLE    mx_{{lowercase timInstance.selection}}_gethandle
#define LED_PWM_{{@index}}_TIM_CHANNEL      {{timChannel}}
{{/with~}} {{!-- resourcesAllocation.pwmCfg --}}

{{/if~}} {{!-- (eq info.interface 'PWM') --}}
{{/with~}} {{!-- @root.ctx --}}
{{/each~}} {{!-- @root.led_instances --}}

{{!---------------------- Part Getters FUNC --------------------------------------------------}}

/* Exported functions ------------------------------------------------------ */
{{#each @root.led_instances}}
{{assign 'ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{#with @root.ctx}}
{{#if (eq info.interface 'PWM')~}}
led_pwm_t *mx_led_pwm_{{@index}}_getobject(void);
{{/if~}}
{{/with~}} {{!-- @root.ctx --}}
{{/each~}} {{!-- @root.led_instances --}}

#ifdef __cplusplus
}
#endif

#endif /* MX_LED_PWM_H */
